# One provider key — the one MODEL's prefix names (anthropic | openai | xai | google_genai).
# `lang-ai-agent init` writes this file for you interactively. Keys live here only, never in git.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
MODEL=anthropic:claude-sonnet-4-5   # init_chat_model "provider:model" — e.g. openai:gpt-5, xai:grok-4, google_genai:gemini-2.5-pro
APP_BEARER_TOKEN=                   # any long random string; `lang-ai-agent init` generates one
CHECKPOINT_DB_PATH=./data/checkpoints.db
SEND_MODE=dry_run                   # dry_run | live — second gate in the effects adapter
LANGSMITH_TRACING=false
MCP_SERVERS_PATH=                   # optional: path to mcp_servers.json; unset = built-in tools only
